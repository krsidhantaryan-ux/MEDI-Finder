# MedFinder Environment Configuration
# Copy to `.env` and fill in secrets when deploying to production / Supabase.

FLASK_SECRET_KEY=replace-with-a-strong-32-byte-secret
MEDIFINDER_ADMIN_USERNAME=admin
MEDIFINDER_ADMIN_PASSWORD=replace-with-strong-admin-password

# Persistent Supabase PostgreSQL (Project ref: mqgejhfudhnliyyzomur, Region: ap-northeast-1)
SUPABASE_PROJECT_REF=mqgejhfudhnliyyzomur
SUPABASE_URL=https://mqgejhfudhnliyyzomur.supabase.co
# Replace [YOUR-DB-PASSWORD] with your Supabase Database Password from Project Settings -> Database:
# Session Pooler (IPv4-compatible, recommended for Render/Railway/Vercel):
# SUPABASE_DB_URL=postgresql://postgres.mqgejhfudhnliyyzomur:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Direct IPv6 host:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.mqgejhfudhnliyyzomur.supabase.co:5432/postgres
